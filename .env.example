# Production template. Copy these into your deployment environment (later: AWS
# Secrets Manager / SSM). Never commit a filled-in copy.

# Must be 0 in production. Settings default to 0 when this is unset (local work sets 1 in .env).
DJANGO_DEBUG=0

# Required when DJANGO_DEBUG=0; the app refuses to start without it. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Required when DJANGO_DEBUG=0. Comma-separated hostnames only: no https://,
# no path, not *. Until there is a domain, use the CloudFront distribution's
# address (d1234abcd.cloudfront.net); when the domain arrives, add it after a
# comma. Nothing else in the app or the page build needs changing.
# Behind CloudFront, have it forward the viewer's Host header to the ALB (origin
# request policy "AllViewer"); otherwise requests arrive with the ALB's own DNS
# name and are refused. Load balancer health checks need no entry here.
DJANGO_ALLOWED_HOSTS=d1234abcd.cloudfront.net

# Not needed while the page and the API share one address (the setup in
# DEPLOY.md). Only for a page on a different origin, e.g. https://retrofit.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Production defaults: redirect HTTP to HTTPS and emit HSTS.
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=31536000

# Set to 1 only when the app is reachable solely through a trusted AWS
# ALB/CloudFront proxy. Leave at 0 if clients can reach it directly.
# Behind an ALB this must be 1: the ALB talks to the app over plain HTTP, so
# with 0 every request is redirected to HTTPS again, forever.
# (The Dockerfile sets 0, so this must be set in the deployment.)
DJANGO_TRUST_PROXY_HEADERS=1

# Which header says the visitor used HTTPS. X-Forwarded-Proto (default) is set
# by the ALB and is right when CloudFront reaches the ALB over HTTPS. Before
# there is a domain, CloudFront must reach the ALB over HTTP (the ALB cannot get
# a certificate without a domain), so use CloudFront-Forwarded-Proto then.
DJANGO_PROXY_SSL_HEADER=CloudFront-Forwarded-Proto

# Number of trusted proxies that append to X-Forwarded-For, used to find the
# real client address for rate limiting: 0 = direct, 1 = ALB, 2 = CloudFront + ALB.
# Behind a proxy, 0 puts every visitor in one shared allowance.
# (The Dockerfile sets 0, so this must be set in the deployment; 2 matches the
# documented CloudFront + ALB topology.)
# Use 2 only if the ALB accepts traffic from CloudFront alone.
DJANGO_TRUSTED_PROXY_COUNT=2

# Random secret CloudFront adds as the X-Origin-Verify header on every origin
# request. Required whenever proxy headers are trusted: it proves a request
# really came through CloudFront, so a direct client cannot forge
# X-Forwarded-For or the HTTPS header. Put it in Secrets Manager and add an ALB
# listener rule that returns 403 when the header is absent.
DJANGO_ORIGIN_VERIFY_SECRET=

# PostgreSQL. Required when DJANGO_DEBUG=0 (production refuses SQLite).
# On AWS RDS, keep the password in Secrets Manager rather than a file.
DJANGO_DB_NAME=retrofit
DJANGO_DB_USER=retrofit_app
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=retrofit.xxxxxxxx.ca-central-1.rds.amazonaws.com
DJANGO_DB_PORT=5432
# require (default in production), verify-ca or verify-full. For verify-full,
# point DJANGO_DB_SSLROOTCERT at the RDS certificate bundle.
DJANGO_DB_SSLMODE=verify-full
# DJANGO_DB_SSLROOTCERT=/etc/ssl/rds-global-bundle.pem
# Seconds to keep a connection open between requests (0 = close after each).
DJANGO_DB_CONN_MAX_AGE=60

# Shared cache for the rate-limit counts: Amazon ElastiCache (Redis or Valkey)
# with in-transit encryption. Must be rediss:// and is required in production:
# without it each process counts on its own, so startup fails instead of
# silently multiplying the limit. A cache outage falls back to a per-process
# limit rather than letting every request through.
DJANGO_REDIS_URL=rediss://retrofit-cache.xxxxxx.cache.amazonaws.com:6379/0

# Requests per address allowed on POST /api/recommend: requests/period, with the period
# s, m, h or d (e.g. 30/m, 500/h, 10/5m). Anything else stops startup.
DJANGO_RECOMMEND_RATE_LIMIT=30/m

# DEBUG, INFO, WARNING, ERROR or CRITICAL. Logs go to stdout (CloudWatch).
DJANGO_LOG_LEVEL=INFO

# Gunicorn (gunicorn.conf.py): about 2 x vCPUs + 1 workers.
GUNICORN_WORKERS=3
# Threads per worker; a stalled connection holds one thread, not a whole worker.
# GUNICORN_THREADS=8
# PORT=8000
